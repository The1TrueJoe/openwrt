+/* The on timer a LED blinks with: Reg2 for PWM1, Reg3 for PWM2 */
+enum ktd202x_timer {
+	KTD202X_TIMER_NONE,
+	KTD202X_TIMER_PWM1,
+	KTD202X_TIMER_PWM2,
+};
