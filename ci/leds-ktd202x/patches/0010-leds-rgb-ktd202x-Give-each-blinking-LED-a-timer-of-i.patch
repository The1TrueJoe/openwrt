-		int channel_state;
-
-		channel = subleds[i].channel;
-		channel_state = (state >> 2 * channel) & KTD202X_CHANNEL_CTRL_MASK(0);
-		if (channel_state == KTD202X_CHANNEL_CTRL_OFF)
-			continue;
-		mode_blink = channel_state == KTD202X_CHANNEL_CTRL_PWM1(0);
-		break;
-	}
+	/* A LED that is turned off stops blinking and frees its timer */
+	if (!led->cdev.brightness)
+		led->timer = KTD202X_TIMER_NONE;
 
 	for (i = 0; i < num_channels; i++) {
 		enum led_brightness brightness;
@@ -247,10 +254,7 @@ static int ktd202x_brightness_set(struct ktd202x_led *led,
 			if (ret)
 				return ret;
 
-			if (mode_blink)
-				mode = KTD202X_CHANNEL_CTRL_PWM1(channel);
-			else
-				mode = KTD202X_CHANNEL_CTRL_ON(channel);
+			mode = ktd202x_channel_mode(led, channel);
 		} else {
 			mode = KTD202X_CHANNEL_CTRL_OFF;
 		}
@@ -337,6 +341,98 @@ static unsigned long ktd202x_flash_period_ms(const struct ktd202x_info *info,
 	return num_steps * KTD202X_FLASH_PERIOD_STEP_MS + info->flash_period_min_ms;
 }
 
+/*
+ * The two on timers share the flash period and the ramp times. A LED keeps
+ * its timer until it is turned off or stops blinking, and another LED can
+ * only get the other timer if it uses the same period and ramps.
+ *
+ * Returns the timer for @led, or -EBUSY.
+ */
+static int ktd202x_timer_get(struct ktd202x_led *led, u8 flash_period,
+			     u8 ramp_times)
+{
+	struct ktd202x *chip = led->chip;
+	unsigned int used = 0;
+	int i;
+
+	for (i = 0; i < chip->num_leds; i++) {
+		struct ktd202x_led *other = &chip->leds[i];
+
+		if (other == led || other->timer == KTD202X_TIMER_NONE)
+			continue;
+
+		if (flash_period != chip->flash_period ||
+		    ramp_times != chip->ramp_times)
+			return -EBUSY;
+
+		used |= BIT(other->timer);
+	}
+
+	if (led->timer != KTD202X_TIMER_NONE)
+		return led->timer;
+	if (!(used & BIT(KTD202X_TIMER_PWM1)))
+		return KTD202X_TIMER_PWM1;
+	if (!(used & BIT(KTD202X_TIMER_PWM2)))
+		return KTD202X_TIMER_PWM2;
+
+	return -EBUSY;
+}
+
+/* Called with the chip mutex held */
+static int ktd202x_timer_set(struct ktd202x_led *led, struct mc_subled *subleds,
+			     unsigned int num_channels, u8 flash_period, u8 on,
+			     u8 ramp_times)
+{
+	struct ktd202x *chip = led->chip;
+	u8 ctrl_mask = 0;
+	u8 ctrl_mode = 0;
+	int timer;
+	int ret;
+	int i;
+
+	timer = ktd202x_timer_get(led, flash_period, ramp_times);
+	led->timer = timer < 0 ? KTD202X_TIMER_NONE : timer;
+
+	for (i = 0; i < num_channels; i++) {
+		int channel = subleds[i].channel;
+
+		ctrl_mask |= KTD202X_CHANNEL_CTRL_MASK(channel);
+		ctrl_mode |= ktd202x_channel_mode(led, channel);
+	}
+
+	/* Without a timer, leave the LED steadily on */
+	if (timer < 0) {
+		ret = regmap_update_bits(chip->regmap, KTD202X_REG_CHANNEL_CTRL,
+					 ctrl_mask, ctrl_mode);
+		return ret ? ret : timer;
+	}
+
+	chip->flash_period = flash_period;
+	chip->ramp_times = ramp_times;
+
+	/*
+	 * Update the shared registers only when they change, so that the
+	 * timer of another LED is not restarted.
+	 */
+	ret = regmap_update_bits(chip->regmap, KTD202X_REG_FLASH_PERIOD, 0xff,
+				 flash_period);
+	if (ret)
+		return ret;
+
+	ret = regmap_update_bits(chip->regmap, KTD202X_REG_TRISE_FALL, 0xff,
+				 ramp_times);
+	if (ret)
+		return ret;
+
+	ret = regmap_write(chip->regmap, timer == KTD202X_TIMER_PWM1 ?
+			   KTD202X_REG_PWM1_TIMER : KTD202X_REG_PWM2_TIMER, on);
+	if (ret)
+		return ret;
+
+	return regmap_update_bits(chip->regmap, KTD202X_REG_CHANNEL_CTRL,
+				  ctrl_mask, ctrl_mode);
+}
+
