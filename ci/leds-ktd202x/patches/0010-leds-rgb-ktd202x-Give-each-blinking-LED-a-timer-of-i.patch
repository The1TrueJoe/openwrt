 	bool enabled;
 	/* Current limit of the channels of multicolor LEDs, in 0.125 mA steps */
 	u8 channel_max[KTD202X_MAX_LEDS];
+	/* Shared by both timers, valid while a LED has a timer */
+	u8 flash_period;
+	u8 ramp_times;
 	unsigned long num_leds;
 	struct ktd202x_led leds[] __counted_by(num_leds);
