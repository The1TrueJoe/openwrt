+/* The channel mode of a lit LED: on, or blinking with its timer */
+static unsigned int ktd202x_channel_mode(struct ktd202x_led *led, int channel)
+{
+	switch (led->timer) {
+	case KTD202X_TIMER_PWM1:
+		return KTD202X_CHANNEL_CTRL_PWM1(channel);
+	case KTD202X_TIMER_PWM2:
+		return KTD202X_CHANNEL_CTRL_PWM2(channel);
+	default:
+		return KTD202X_CHANNEL_CTRL_ON(channel);
+	}
+}
