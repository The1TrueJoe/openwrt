CONFIG_PRINTK_TIME=y
CONFIG_SLUB_DEBUG=y
CONFIG_BRIDGE=y
CONFIG_BLK_DEV_SD=y
CONFIG_USB_STORAGE=y
CONFIG_INPUT_EVDEV=y
CONFIG_WATCHDOG_SYSFS=y
