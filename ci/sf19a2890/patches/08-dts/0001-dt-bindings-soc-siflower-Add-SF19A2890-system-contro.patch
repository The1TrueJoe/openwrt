From c2683506168bce5134229d3b65136675595d3da7 Mon Sep 17 00:00:00 2001
From: Joseph Telaak <joseph@telaak.dev>
Date: Mon, 2 Nov 2026 22:26:43 -0500
Subject: [PATCH 1/4] dt-bindings: soc: siflower: Add SF19A2890 system
 controller

The Siflower SF19A2890 has a block of miscellaneous system registers,
among them the one that resets the SoC. Describe it as a syscon whose
reboot child uses that register.

Signed-off-by: Joseph Telaak <joseph@telaak.dev>
---
 .../siflower/siflower,sf19a2890-sysctl.yaml   | 48 +++++++++++++++++++
 1 file changed, 48 insertions(+)
 create mode 100644 Documentation/devicetree/bindings/soc/siflower/siflower,sf19a2890-sysctl.yaml

diff --git a/Documentation/devicetree/bindings/soc/siflower/siflower,sf19a2890-sysctl.yaml b/Documentation/devicetree/bindings/soc/siflower/siflower,sf19a2890-sysctl.yaml
new file mode 100644
index 000000000..6e5e884f9
--- /dev/null
+++ b/Documentation/devicetree/bindings/soc/siflower/siflower,sf19a2890-sysctl.yaml
@@ -0,0 +1,48 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/soc/siflower/siflower,sf19a2890-sysctl.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Siflower SF19A2890 system controller
+
+maintainers:
+  - Joseph Telaak <joseph@telaak.dev>
+
+description:
+  A block of miscellaneous system registers of the Siflower SF19A2890,
+  among them the one that resets the SoC.
+
+properties:
+  compatible:
+    items:
+      - const: siflower,sf19a2890-sysctl
+      - const: syscon
+      - const: simple-mfd
+
+  reg:
+    maxItems: 1
+
+  reboot:
+    type: object
+    $ref: /schemas/power/reset/syscon-reboot.yaml#
+    unevaluatedProperties: false
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
+
+examples:
+  - |
+    syscon@19e02000 {
+        compatible = "siflower,sf19a2890-sysctl", "syscon", "simple-mfd";
+        reg = <0x19e02000 0x100>;
+
+        reboot {
+            compatible = "syscon-reboot";
+            offset = <0x30>;
+            value = <0x1>;
+        };
+    };
-- 
