From 690e6de38403bf06a7de66c98216cd8505b5ca8b Mon Sep 17 00:00:00 2001
From: Joseph Telaak <joseph@telaak.dev>
Date: Mon, 2 Nov 2026 18:05:42 -0500
Subject: [PATCH 3/3] MIPS: configs: sf19a2890: Enable the SoC and GL-SFT1200
 drivers

Enable the drivers for the SF19A2890's peripherals and for the
GL.iNet GL-SFT1200's switch, SPI NAND, LEDs and buttons.

Signed-off-by: Joseph Telaak <joseph@telaak.dev>
---
 arch/mips/configs/sf19a2890_defconfig | 33 +++++++++++++++++++++++++++
 1 file changed, 33 insertions(+)

diff --git a/arch/mips/configs/sf19a2890_defconfig b/arch/mips/configs/sf19a2890_defconfig
index ec0992ac6..872cc4255 100644
--- a/arch/mips/configs/sf19a2890_defconfig
+++ b/arch/mips/configs/sf19a2890_defconfig
@@ -13,3 +13,36 @@ CONFIG_SERIAL_AMBA_PL011=y
 CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
 CONFIG_TMPFS=y
 CONFIG_PRINTK_TIME=y
+CONFIG_NET=y
+CONFIG_PACKET=y
+CONFIG_UNIX=y
+CONFIG_INET=y
+CONFIG_NET_DSA=y
+CONFIG_MTD=y
+CONFIG_MTD_SPI_NAND=y
+CONFIG_MTD_UBI=y
+CONFIG_NETDEVICES=y
+CONFIG_STMMAC_ETH=y
+CONFIG_DWMAC_SF19A2890=y
+CONFIG_NET_DSA_MXL_GSW1XX=y
+CONFIG_INTEL_XWAY_PHY=y
+CONFIG_INPUT_EVDEV=y
+CONFIG_KEYBOARD_GPIO=y
+CONFIG_I2C=y
+CONFIG_I2C_CHARDEV=y
+CONFIG_I2C_DESIGNWARE_PLATFORM=y
+CONFIG_SPI=y
+CONFIG_SPI_PL022=y
+CONFIG_PINCTRL_SF19A2890=y
+CONFIG_GPIO_SIFLOWER=y
+CONFIG_POWER_RESET=y
+CONFIG_POWER_RESET_SYSCON=y
+CONFIG_WATCHDOG=y
+CONFIG_DW_WATCHDOG=y
+CONFIG_USB=y
+CONFIG_USB_DWC2=y
+CONFIG_USB_STORAGE=y
+CONFIG_NEW_LEDS=y
+CONFIG_LEDS_CLASS=y
+CONFIG_LEDS_KTD202X=y
+CONFIG_PHY_SF19A2890_USB=y
