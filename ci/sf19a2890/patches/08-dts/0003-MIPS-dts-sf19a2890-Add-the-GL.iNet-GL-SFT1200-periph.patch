From 74d13219f7e720eba3a4669cc3d7943a3f0740d4 Mon Sep 17 00:00:00 2001
From: Joseph Telaak <joseph@telaak.dev>
Date: Mon, 2 Nov 2026 18:05:42 -0500
Subject: [PATCH 3/4] MIPS: dts: sf19a2890: Add the GL.iNet GL-SFT1200
 peripherals

Describe the rest of the GL.iNet GL-SFT1200 ("Opal"):

- the reset button and the mode slide switch;
- the 128 MiB SPI NAND, with the base MAC address in the factory
  partition;
- the MaxLinear GSW150 switch on the GMAC's MDIO bus, with its WAN
  port and two LAN ports and the GMAC on its RGMII port; the GMAC adds
  both RGMII clock delays, 935 ps TX and 550 ps RX, the delays the
  bootloader sets, which sit inside the windows a sweep finds;
- the Etek ET6326 LED driver on I2C, with the blue status and white
  WAN lights;
- the USB 2.0 host port.

The GMAC's FIFO sizes are given because this core does not report
them, and stmmac refuses to change the MTU, which DSA needs, without
the TX FIFO size.

Signed-off-by: Joseph Telaak <joseph@telaak.dev>
---
 .../siflower/sf19a2890-glinet-gl-sft1200.dts  | 224 ++++++++++++++++++
 1 file changed, 224 insertions(+)

diff --git a/arch/mips/boot/dts/siflower/sf19a2890-glinet-gl-sft1200.dts b/arch/mips/boot/dts/siflower/sf19a2890-glinet-gl-sft1200.dts
index 13e6a0c8b..717aa2a0d 100644
--- a/arch/mips/boot/dts/siflower/sf19a2890-glinet-gl-sft1200.dts
+++ b/arch/mips/boot/dts/siflower/sf19a2890-glinet-gl-sft1200.dts
@@ -2,6 +2,10 @@
 
 /dts-v1/;
 
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include <dt-bindings/leds/common.h>
+
 #include "sf19a2890.dtsi"
 
 / {
@@ -20,8 +24,228 @@ memory@0 {
 		device_type = "memory";
 		reg = <0x0 0x8000000>;
 	};
+
+	keys {
+		compatible = "gpio-keys";
+
+		key-reset {
+			label = "reset";
+			gpios = <&gpio 27 GPIO_ACTIVE_LOW>;
+			linux,code = <KEY_RESTART>;
+		};
+
+		/* A slide switch: BTN_0 is pressed while it is in one position */
+		switch-mode {
+			label = "mode";
+			gpios = <&gpio 1 GPIO_ACTIVE_LOW>;
+			linux,code = <BTN_0>;
+		};
+	};
+};
+
+&gmac {
+	phy-mode = "rgmii-id";
+	tx-internal-delay-ps = <935>;
+	rx-internal-delay-ps = <550>;
+	nvmem-cells = <&macaddr_factory_0 0>;
+	nvmem-cell-names = "mac-address";
+
+	/*
+	 * This DWMAC 3.73a does not report its FIFO sizes. Without a TX FIFO
+	 * size stmmac refuses any MTU change, so DSA cannot make room for the
+	 * switch tag. The vendor firmware sends 1522-byte frames in TX
+	 * store-and-forward mode, so the TX FIFO holds at least 2 KiB. An RX
+	 * FIFO size below 4 KiB keeps hardware flow control off, as the vendor
+	 * firmware does.
+	 */
+	tx-fifo-depth = <2048>;
+	rx-fifo-depth = <2048>;
+	status = "okay";
+
+	fixed-link {
+		speed = <1000>;
+		full-duplex;
+		pause;
+	};
+};
+
+&i2c0 {
+	clock-frequency = <400000>;
+	status = "okay";
+
+	led-controller@30 {
+		compatible = "etekmicro,et6326", "kinetic,ktd2026";
+		reg = <0x30>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		/* Each channel drives three LEDs in parallel, D3 is not connected */
+		led@0 {
+			reg = <0>;
+			function = LED_FUNCTION_STATUS;
+			color = <LED_COLOR_ID_BLUE>;
+			led-max-microamp = <1375>;
+		};
+
+		led@1 {
+			reg = <1>;
+			function = LED_FUNCTION_WAN_ONLINE;
+			color = <LED_COLOR_ID_WHITE>;
+			led-max-microamp = <1375>;
+		};
+	};
+};
+
+&mdio {
+	switch@1f {
+		compatible = "intel,gsw150";
+		reg = <0x1f>;
+		reset-gpios = <&gpio 0 GPIO_ACTIVE_LOW>;
+
+		ports {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			port@0 {
+				reg = <0>;
+				label = "wan";
+				phy-handle = <&switchphy0>;
+				phy-mode = "internal";
+				nvmem-cells = <&macaddr_factory_0 0>;
+				nvmem-cell-names = "mac-address";
+			};
+
+			port@1 {
+				reg = <1>;
+				label = "lan2";
+				phy-handle = <&switchphy1>;
+				phy-mode = "internal";
+				nvmem-cells = <&macaddr_factory_0 1>;
+				nvmem-cell-names = "mac-address";
+			};
+
+			port@2 {
+				reg = <2>;
+				label = "lan1";
+				phy-handle = <&switchphy2>;
+				phy-mode = "internal";
+				nvmem-cells = <&macaddr_factory_0 1>;
+				nvmem-cell-names = "mac-address";
+			};
+
+			/*
+			 * The GMAC adds both RGMII delays, so the switch adds
+			 * none: for this port "rgmii-id" sets them to zero.
+			 */
+			port@5 {
+				reg = <5>;
+				phy-mode = "rgmii-id";
+				ethernet = <&gmac>;
+
+				fixed-link {
+					speed = <1000>;
+					full-duplex;
+				};
+			};
+		};
+
+		mdio {
+			#address-cells = <1>;
+			#size-cells = <0>;
+
+			switchphy0: ethernet-phy@0 {
+				reg = <0>;
+			};
+
+			switchphy1: ethernet-phy@1 {
+				reg = <1>;
+			};
+
+			switchphy2: ethernet-phy@2 {
+				reg = <2>;
+			};
+		};
+	};
+};
+
+&spi {
+	cs-gpios = <&gpio 8 GPIO_ACTIVE_LOW>;
+	status = "okay";
+
+	flash@0 {
+		compatible = "spi-nand";
+		reg = <0>;
+		spi-max-frequency = <30000000>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			partition@0 {
+				label = "spl-loader";
+				reg = <0x0 0x20000>;
+				read-only;
+			};
+
+			partition@20000 {
+				label = "u-boot";
+				reg = <0x20000 0x60000>;
+				read-only;
+			};
+
+			partition@80000 {
+				label = "u-boot-env";
+				reg = <0x80000 0x20000>;
+				read-only;
+			};
+
+			partition@a0000 {
+				label = "factory";
+				reg = <0xa0000 0x20000>;
+				read-only;
+
+				nvmem-layout {
+					compatible = "fixed-layout";
+					#address-cells = <1>;
+					#size-cells = <1>;
+
+					macaddr_factory_0: macaddr@0 {
+						compatible = "mac-base";
+						reg = <0x0 0x6>;
+						#nvmem-cell-cells = <1>;
+					};
+				};
+			};
+
+			/* U-Boot loads only the first 3 MiB of this partition */
+			partition@c0000 {
+				label = "kernel";
+				reg = <0xc0000 0x400000>;
+			};
+
+			partition@4c0000 {
+				label = "ubi";
+				reg = <0x4c0000 0x7940000>;
+			};
+
+			partition@7e00000 {
+				label = "log";
+				reg = <0x7e00000 0x40000>;
+			};
+		};
+	};
 };
 
 &uart0 {
 	status = "okay";
 };
+
+&usb {
+	dr_mode = "host";
+	status = "okay";
+};
+
+&usb_phy {
+	status = "okay";
+};
-- 
