From: Joseph Telaak <joseph@telaak.dev>
Date: Mon, 2 Nov 2026 18:05:42 -0500
Subject: [PATCH 4/4] MIPS: configs: sf19a2890: Enable the SoC and GL-SFT1200
 drivers

Enable the drivers for the SF19A2890's peripherals and for the
GL.iNet GL-SFT1200's switch, SPI NAND, LEDs and buttons.

Signed-off-by: Joseph Telaak <joseph@telaak.dev>
---
 arch/mips/configs/sf19a2890_defconfig | 36 +++++++++++++++++++++++++++
 1 file changed, 36 insertions(+)

diff --git a/arch/mips/configs/sf19a2890_defconfig b/arch/mips/configs/sf19a2890_defconfig
index ec0992ac6..e0db386e7 100644
--- a/arch/mips/configs/sf19a2890_defconfig
+++ b/arch/mips/configs/sf19a2890_defconfig
@@ -7,9 +7,45 @@ CONFIG_MACH_SIFLOWER_MIPS=y
 CONFIG_MIPS_CPS=y
 CONFIG_NR_CPUS=4
 CONFIG_MIPS_RAW_APPENDED_DTB=y
+CONFIG_NET=y
+CONFIG_PACKET=y
+CONFIG_UNIX=y
+CONFIG_INET=y
+CONFIG_NET_DSA=y
 CONFIG_DEVTMPFS=y
 CONFIG_DEVTMPFS_MOUNT=y
+CONFIG_MTD=y
+CONFIG_MTD_SPI_NAND=y
+CONFIG_MTD_UBI=y
+CONFIG_SCSI=y
+CONFIG_BLK_DEV_SD=y
+CONFIG_NETDEVICES=y
+CONFIG_NET_DSA_MXL_GSW1XX=y
+CONFIG_STMMAC_ETH=y
+CONFIG_INTEL_XWAY_PHY=y
+CONFIG_INPUT_EVDEV=y
+CONFIG_KEYBOARD_GPIO=y
 CONFIG_SERIAL_AMBA_PL011=y
 CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
+CONFIG_I2C=y
+CONFIG_I2C_CHARDEV=y
+CONFIG_I2C_DESIGNWARE_CORE=y
+CONFIG_SPI=y
+CONFIG_SPI_PL022=y
+CONFIG_PINCTRL=y
+CONFIG_GPIOLIB=y
+CONFIG_GPIO_SIFLOWER=y
+CONFIG_POWER_RESET=y
+CONFIG_POWER_RESET_SYSCON=y
+CONFIG_WATCHDOG=y
+CONFIG_DW_WATCHDOG=y
+CONFIG_USB=y
+CONFIG_USB_STORAGE=y
+CONFIG_USB_DWC2=y
+CONFIG_NEW_LEDS=y
+CONFIG_LEDS_CLASS=y
+CONFIG_LEDS_CLASS_MULTICOLOR=y
+CONFIG_LEDS_KTD202X=y
+CONFIG_PHY_SF19A2890_USB=y
 CONFIG_TMPFS=y
 CONFIG_PRINTK_TIME=y
