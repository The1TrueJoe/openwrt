+config CLK_SF19A2890_PERIPHCRM
+	bool "Clock driver for Siflower SF19A2890 peripherals"
+	depends on MACH_SIFLOWER_MIPS || COMPILE_TEST
+	default MACH_SIFLOWER_MIPS
+	select AUXILIARY_BUS
+	select RESET_CONTROLLER
