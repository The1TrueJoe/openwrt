@@ -0,0 +1,82 @@
+# SPDX-License-Identifier: (GPL-2.0-only OR BSD-2-Clause)
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/clock/siflower,sf19a2890-sysm.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Siflower SF19A2890 system manager
+
+maintainers:
+  - Joseph Telaak <joseph@telaak.dev>
+
+description: |
+  The system manager of the Siflower SF19A2890 holds the SoC's PLLs and
+  clock dividers, and for each peripheral a reset register and a set of
+  clock gates. It also holds miscellaneous controls used by other
+  devices, such as the GMAC interface configuration, the USB PHY
+  controls and the reboot register.
+
+  The clocks are defined in
+  include/dt-bindings/clock/siflower,sf19a2890-sysm.h and the resets in
+  include/dt-bindings/reset/siflower,sf19a2890-sysm.h.
+
+properties:
+  compatible:
+    items:
+      - const: siflower,sf19a2890-sysm
+      - const: syscon
+
+  reg:
+    maxItems: 1
+
+  clocks:
+    items:
+      - description: 12 MHz oscillator
+      - description: 40 MHz oscillator
+      - description: 32.768 kHz oscillator
+
+  clock-names:
+    items:
+      - const: osc12m
+      - const: osc40m
+      - const: osc32k
+
+  "#clock-cells":
+    const: 1
+
+  "#reset-cells":
+    const: 1
+
+  reboot:
+    type: object
+    $ref: /schemas/power/reset/syscon-reboot.yaml#
+    unevaluatedProperties: false
+    description:
+      Reboot method for the SoC.
+
+required:
+  - compatible
+  - reg
+  - clocks
+  - clock-names
+  - "#clock-cells"
+  - "#reset-cells"
+
+additionalProperties: false
+
+examples:
+  - |
+    clock-controller@19e00000 {
+        compatible = "siflower,sf19a2890-sysm", "syscon";
+        reg = <0x19e00000 0x30000>;
+        clocks = <&osc12m>, <&osc40m>, <&osc32k>;
+        clock-names = "osc12m", "osc40m", "osc32k";
+        #clock-cells = <1>;
+        #reset-cells = <1>;
+
+        reboot {
+            compatible = "syscon-reboot";
+            offset = <0x2030>;
+            value = <0x1>;
+        };
+    };
