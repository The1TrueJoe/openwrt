+
+struct sf19a2890_reset {
+	u32 periph;
+	u32 mask;
+};
+
+static const struct sf19a2890_reset sf19a2890_resets[] = {
+	[RST_GMAC]		= { PERIPH_GMAC, GENMASK(1, 0) },
+	[RST_WLAN24]		= { PERIPH_WLAN24, GENMASK(2, 0) },
+	[RST_RF]		= { PERIPH_RF, GENMASK(2, 0) },
+	[RST_USB]		= { PERIPH_USB, GENMASK(2, 0) },
+	[RST_USB_PHY_POR]	= { PERIPH_USB, BIT(3) },
+	[RST_USB_PHY]		= { PERIPH_USB, BIT(4) },
+	[RST_WLAN5]		= { PERIPH_WLAN5, GENMASK(2, 0) },
+	[RST_I2C0]		= { PERIPH_I2C0, BIT(0) },
+	[RST_SPI]		= { PERIPH_SPI, GENMASK(5, 4) },
+	[RST_UART0]		= { PERIPH_UART, BIT(0) | BIT(4) },
+	[RST_UART1]		= { PERIPH_UART, BIT(1) | BIT(5) },
+	[RST_UART2]		= { PERIPH_UART, BIT(2) | BIT(6) },
+	[RST_PWM]		= { PERIPH_PWM, BIT(0) },
+	[RST_TIMER]		= { PERIPH_TIMER, BIT(0) },
+	[RST_WDT]		= { PERIPH_WDT, BIT(0) },
+	[RST_GPIO]		= { PERIPH_GPIO, BIT(0) },
+};
+
+static struct sf19a2890_sysm *sf19a2890_sysm;
+
+#define to_sf19a2890_sysm(_rcdev) \
+	container_of(_rcdev, struct sf19a2890_sysm, rcdev)
+
+static int sf19a2890_reset_update(struct reset_controller_dev *rcdev,
+				  unsigned long id, bool assert)
+{
+	struct sf19a2890_sysm *sysm = to_sf19a2890_sysm(rcdev);
+	const struct sf19a2890_reset *rst = &sf19a2890_resets[id];
+	void __iomem *reg = sysm->base + rst->periph + REG_PERIPH_RESET;
+	u32 val;
+
+	guard(spinlock_irqsave)(&sysm->lock);
+
+	val = readl(reg);
+	if (assert)
+		val |= rst->mask;
+	else
+		val &= ~rst->mask;
+	writel(val, reg);
+
+	return 0;
+}
+
+static int sf19a2890_reset_assert(struct reset_controller_dev *rcdev,
+				  unsigned long id)
+{
+	return sf19a2890_reset_update(rcdev, id, true);
+}
+
+static int sf19a2890_reset_deassert(struct reset_controller_dev *rcdev,
+				    unsigned long id)
+{
+	return sf19a2890_reset_update(rcdev, id, false);
+}
+
+static int sf19a2890_reset_status(struct reset_controller_dev *rcdev,
+				  unsigned long id)
+{
+	struct sf19a2890_sysm *sysm = to_sf19a2890_sysm(rcdev);
+	const struct sf19a2890_reset *rst = &sf19a2890_resets[id];
+
+	return !!(readl(sysm->base + rst->periph + REG_PERIPH_RESET) &
+		  rst->mask);
+}
+
+static const struct reset_control_ops sf19a2890_reset_ops = {
+	.assert = sf19a2890_reset_assert,
+	.deassert = sf19a2890_reset_deassert,
+	.status = sf19a2890_reset_status,
+};
+
+static int __init sf19a2890_register_gates(struct device_node *np,
+					   struct sf19a2890_sysm *sysm)
+{
+	struct clk_hw **hws = sysm->clk_data.hws;
+	int i, ret;
+
+	for (i = 0; i < ARRAY_SIZE(sf19a2890_gates); i++) {
+		const struct sf19a2890_gate *g = &sf19a2890_gates[i];
+		struct clk_init_data init = {
+			.name = g->name,
+			.ops = &sf19a2890_gate_ops,
+			.parent_data = &g->parent,
+			.num_parents = 1,
+			.flags = g->flags,
+		};
+		struct sf19a2890_clk *clk;
+
+		clk = kzalloc_obj(*clk);
+		if (!clk)
+			return -ENOMEM;
+
+		clk->sysm = sysm;
+		clk->offset = g->periph;
+		clk->bit = g->bit;
+		clk->hw.init = &init;
+
+		ret = of_clk_hw_register(np, &clk->hw);
+		if (ret) {
+			kfree(clk);
+			return ret;
+		}
+
+		hws[g->id] = &clk->hw;
+	}
+
+	return 0;
+}
+
+static int __init sf19a2890_register_clk(struct device_node *np,
+					 struct sf19a2890_sysm *sysm,
+					 struct sf19a2890_clk *clk,
+					 unsigned int id)
+{
+	clk->sysm = sysm;
+	sysm->clk_data.hws[id] = &clk->hw;
+
+	/* With the node, so that the oscillators are found by name */
+	return of_clk_hw_register(np, &clk->hw);
+}
+
+/*
+ * The GIC timer needs the CPU clock before platform devices probe, so the
+ * clocks are registered from here. The resets follow when the platform
+ * device probes.
+ */
+static void __init sf19a2890_sysm_init(struct device_node *np)
+{
+	struct sf19a2890_sysm *sysm;
+	int i, ret;
+
+	sysm = kzalloc(struct_size(sysm, clk_data.hws, SF19A2890_NR_CLKS),
+		       GFP_KERNEL);
+	if (!sysm)
+		return;
+
+	sysm->base = of_iomap(np, 0);
+	if (!sysm->base) {
+		pr_err("%pOF: failed to map registers\n", np);
+		goto err_free;
+	}
+
+	spin_lock_init(&sysm->lock);
+	sysm->clk_data.num = SF19A2890_NR_CLKS;
+
+	for (i = 0; i < ARRAY_SIZE(sf19a2890_plls); i++) {
+		ret = sf19a2890_register_clk(np, sysm, &sf19a2890_plls[i],
+					     CLK_PLL_CPU + i);
+		if (ret)
+			goto err;
+	}
+
+	for (i = 0; i < ARRAY_SIZE(sf19a2890_muxdivs); i++) {
+		ret = sf19a2890_register_clk(np, sysm, &sf19a2890_muxdivs[i],
+					     CLK_MUXDIV_BUS1 + i);
+		if (ret)
+			goto err;
+	}
+
+	ret = sf19a2890_register_gates(np, sysm);
+	if (ret)
+		goto err;
+
+	ret = of_clk_add_hw_provider(np, of_clk_hw_onecell_get,
+				     &sysm->clk_data);
+	if (ret)
+		goto err;
+
+	sf19a2890_sysm = sysm;
+	return;
+
+err:
+	/* The clocks registered so far stay: the system can't run without */
+	pr_err("%pOF: failed to register clocks: %d\n", np, ret);
+	return;
+err_free:
+	kfree(sysm);
+}
+
+CLK_OF_DECLARE_DRIVER(sf19a2890_sysm, "siflower,sf19a2890-sysm",
+		      sf19a2890_sysm_init);
+
+static int sf19a2890_sysm_probe(struct platform_device *pdev)
+{
+	struct sf19a2890_sysm *sysm = sf19a2890_sysm;
+	struct device *dev = &pdev->dev;
+	int ret;
+
+	if (!sysm)
+		return -ENODEV;
+
+	sysm->rcdev.owner = THIS_MODULE;
+	sysm->rcdev.ops = &sf19a2890_reset_ops;
+	sysm->rcdev.nr_resets = ARRAY_SIZE(sf19a2890_resets);
+	sysm->rcdev.of_node = dev->of_node;
+
+	ret = devm_reset_controller_register(dev, &sysm->rcdev);
+	if (ret)
+		return ret;
+
+	return devm_of_platform_populate(dev);
+}
+
+static const struct of_device_id sf19a2890_sysm_match[] = {
+	{ .compatible = "siflower,sf19a2890-sysm" },
+	{ }
+};
+
+static struct platform_driver sf19a2890_sysm_driver = {
+	.probe = sf19a2890_sysm_probe,
+	.driver = {
+		.name = "sf19a2890-sysm",
+		.of_match_table = sf19a2890_sysm_match,
+		.suppress_bind_attrs = true,
+	},
+};
+builtin_platform_driver(sf19a2890_sysm_driver);
