--- /dev/null
+++ b/drivers/clk/siflower/clk-sf19a2890.c
@@ -0,0 +1,674 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Siflower SF19A2890 system manager: clocks and resets
+ *
+ * Based on the OpenWrt drivers by Chuanhong Guo <gch981213@gmail.com>.
+ */
+
+#include <linux/bitfield.h>
+#include <linux/bits.h>
+#include <linux/clk-provider.h>
+#include <linux/io.h>
+#include <linux/math64.h>
+#include <linux/of.h>
+#include <linux/of_address.h>
+#include <linux/of_platform.h>
+#include <linux/platform_device.h>
+#include <linux/reset-controller.h>
+#include <linux/slab.h>
+#include <linux/spinlock.h>
+
+#include <dt-bindings/clock/siflower,sf19a2890-sysm.h>
+#include <dt-bindings/reset/siflower,sf19a2890-sysm.h>
+
+/* PLLs */
+#define PLL_CPU			0x1000
+#define PLL_DDR			0x1040
+#define PLL_CMN			0x1080
+
+#define REG_PLL_PD		0x00
+#define  PLL_PD_DSM		BIT(5)
+/*
+ * The PLL parameters are a 48-bit value spread over six registers, eight
+ * bits in each, least significant first.
+ */
+#define REG_PLL_PARAM(n)	(0x04 + (n) * 4)
+#define  PLL_REFDIV		GENMASK_ULL(47, 42)
+#define  PLL_POSTDIV2		GENMASK_ULL(41, 39)
+#define  PLL_POSTDIV1		GENMASK_ULL(38, 36)
+#define  PLL_FRAC		GENMASK_ULL(35, 12)
+#define  PLL_FBDIV		GENMASK_ULL(11, 0)
+#define  PLL_FRAC_BITS		24
+#define REG_PLL_CFG		0x1c
+#define  PLL_CFG_SRC		GENMASK(2, 1)
+#define  PLL_CFG_SRC_OSC40M	1
+/*
+ * The state of the clock source override pin. When it is set, the PLLs
+ * run from the 40 MHz oscillator whatever PLL_CFG_SRC says.
+ */
+#define REG_PLL_SRC_OVERRIDE	0x24
+
+/* Clock muxes and dividers */
+#define MUXDIV(n)		(0x1400 + (n))
+#define REG_MUXDIV_CFG		0x00
+#define  MUXDIV_SRC_SEL		GENMASK(2, 0)
+#define REG_MUXDIV_RATIO	0x04
+#define  MUXDIV_RATIO_MAX	0xff
+#define REG_MUXDIV_EN		0x0c
+
+/*
+ * Each peripheral has a block of registers: its resets at 0x0, its clock
+ * gates at 0x4, and at 0xc the enable of its bus outputs, which it needs
+ * as well as a clock to answer bus requests.
+ */
+#define REG_PERIPH_RESET	0x0
+#define REG_PERIPH_GATE		0x4
+#define REG_PERIPH_BOE		0xc
+#define  PERIPH_BOE_EN		GENMASK(1, 0)
+
+#define PERIPH_GMAC		0x4400
+#define PERIPH_WLAN24		0x8000
+#define PERIPH_RF		0x8800
+#define PERIPH_USB		0xc000
+#define PERIPH_WLAN5		0xc400
+#define PERIPH_I2C0		0x24400
+#define PERIPH_SPI		0x24800
+#define PERIPH_UART		0x24c00
+#define PERIPH_PWM		0x25400
+#define PERIPH_TIMER		0x25800
+#define PERIPH_WDT		0x25c00
+#define PERIPH_GPIO		0x2b400
+
+#define SF19A2890_NR_CLKS	(CLK_GPIO + 1)
+
+struct sf19a2890_sysm {
+	void __iomem *base;
+	/* Serializes read-modify-write of the gate and reset registers */
+	spinlock_t lock;
+	struct reset_controller_dev rcdev;
+	struct clk_hw_onecell_data clk_data;
+};
+
+struct sf19a2890_clk {
+	struct clk_hw hw;
+	struct sf19a2890_sysm *sysm;
+	u32 offset;
+	u32 bit;
+};
+
+#define to_sf19a2890_clk(_hw) container_of(_hw, struct sf19a2890_clk, hw)
+
+static u32 sf19a2890_readl(struct sf19a2890_clk *clk, u32 reg)
+{
+	return readl(clk->sysm->base + clk->offset + reg);
+}
+
+static void sf19a2890_writel(struct sf19a2890_clk *clk, u32 reg, u32 val)
+{
+	writel(val, clk->sysm->base + clk->offset + reg);
+}
+
+static u64 sf19a2890_pll_param(struct sf19a2890_clk *clk)
+{
+	u64 param = 0;
+	int i;
+
+	for (i = 5; i >= 0; i--)
+		param = (param << 8) |
+			(sf19a2890_readl(clk, REG_PLL_PARAM(i)) & 0xff);
+
+	return param;
+}
+
+static unsigned long sf19a2890_pll_recalc_rate(struct clk_hw *hw,
+					       unsigned long parent_rate)
+{
+	struct sf19a2890_clk *clk = to_sf19a2890_clk(hw);
+	u64 param = sf19a2890_pll_param(clk);
+	u32 refdiv = FIELD_GET(PLL_REFDIV, param);
+	u32 postdiv1 = FIELD_GET(PLL_POSTDIV1, param);
+	u32 postdiv2 = FIELD_GET(PLL_POSTDIV2, param);
+	u64 rate;
+
+	if (!refdiv || !postdiv1 || !postdiv2)
+		return 0;
+
+	/* VCO = parent / refdiv * (fbdiv + frac / 2^24) */
+	rate = (u64)parent_rate * FIELD_GET(PLL_FBDIV, param) << PLL_FRAC_BITS;
+	if (!(sf19a2890_readl(clk, REG_PLL_PD) & PLL_PD_DSM))
+		rate += (u64)parent_rate * FIELD_GET(PLL_FRAC, param);
+
+	rate = div_u64(rate, refdiv * postdiv1 * postdiv2);
+
+	return rate >> PLL_FRAC_BITS;
+}
+
+static u8 sf19a2890_pll_get_parent(struct clk_hw *hw)
+{
+	struct sf19a2890_clk *clk = to_sf19a2890_clk(hw);
+	u32 cfg;
+
+	if (sf19a2890_readl(clk, REG_PLL_SRC_OVERRIDE) & BIT(0))
+		return 1;
+
+	cfg = sf19a2890_readl(clk, REG_PLL_CFG);
+
+	return FIELD_GET(PLL_CFG_SRC, cfg) == PLL_CFG_SRC_OSC40M;
+}
+
+static const struct clk_ops sf19a2890_pll_ops = {
+	.recalc_rate = sf19a2890_pll_recalc_rate,
+	.get_parent = sf19a2890_pll_get_parent,
+};
+
+static unsigned long sf19a2890_muxdiv_recalc_rate(struct clk_hw *hw,
+						  unsigned long parent_rate)
+{
+	struct sf19a2890_clk *clk = to_sf19a2890_clk(hw);
+	u32 ratio = sf19a2890_readl(clk, REG_MUXDIV_RATIO) & MUXDIV_RATIO_MAX;
+
+	return parent_rate / (ratio + 1);
+}
+
+static unsigned int sf19a2890_muxdiv_div(unsigned long rate,
+					 unsigned long parent_rate)
+{
+	unsigned int div;
+
+	div = DIV_ROUND_CLOSEST(parent_rate, rate ?: 1);
+
+	return clamp(div, 1U, MUXDIV_RATIO_MAX + 1U);
+}
+
+static int sf19a2890_muxdiv_determine_rate(struct clk_hw *hw,
+					   struct clk_rate_request *req)
+{
+	unsigned int div = sf19a2890_muxdiv_div(req->rate,
+						req->best_parent_rate);
+
+	req->rate = req->best_parent_rate / div;
+
+	return 0;
+}
+
+static int sf19a2890_muxdiv_set_rate(struct clk_hw *hw, unsigned long rate,
+				     unsigned long parent_rate)
+{
+	struct sf19a2890_clk *clk = to_sf19a2890_clk(hw);
+	unsigned int div = sf19a2890_muxdiv_div(rate, parent_rate);
+
+	sf19a2890_writel(clk, REG_MUXDIV_RATIO, div - 1);
+
+	return 0;
+}
+
+static int sf19a2890_muxdiv_enable(struct clk_hw *hw)
+{
+	sf19a2890_writel(to_sf19a2890_clk(hw), REG_MUXDIV_EN, 1);
+
+	return 0;
+}
+
+static void sf19a2890_muxdiv_disable(struct clk_hw *hw)
+{
+	sf19a2890_writel(to_sf19a2890_clk(hw), REG_MUXDIV_EN, 0);
+}
+
+static int sf19a2890_muxdiv_is_enabled(struct clk_hw *hw)
+{
+	return !!sf19a2890_readl(to_sf19a2890_clk(hw), REG_MUXDIV_EN);
+}
+
+/*
+ * The source select values: 0, 1 and 2 are the CPU, DDR and common PLLs,
+ * 4 is the 12 MHz oscillator and 6 the 40 MHz one.
+ */
+static const u8 sf19a2890_muxdiv_src[] = { 0, 1, 2, 4, 6 };
+
+static u8 sf19a2890_muxdiv_get_parent(struct clk_hw *hw)
+{
+	struct sf19a2890_clk *clk = to_sf19a2890_clk(hw);
+	u32 src = FIELD_GET(MUXDIV_SRC_SEL,
+			    sf19a2890_readl(clk, REG_MUXDIV_CFG));
+	u8 i;
+
+	for (i = 0; i < ARRAY_SIZE(sf19a2890_muxdiv_src); i++)
+		if (sf19a2890_muxdiv_src[i] == src)
+			return i;
+
+	return ARRAY_SIZE(sf19a2890_muxdiv_src) - 1;
+}
+
+static int sf19a2890_muxdiv_set_parent(struct clk_hw *hw, u8 index)
+{
+	struct sf19a2890_clk *clk = to_sf19a2890_clk(hw);
+
+	sf19a2890_writel(clk, REG_MUXDIV_CFG,
+			 FIELD_PREP(MUXDIV_SRC_SEL,
+				    sf19a2890_muxdiv_src[index]));
+
+	return 0;
+}
+
+static const struct clk_ops sf19a2890_muxdiv_ops = {
+	.recalc_rate = sf19a2890_muxdiv_recalc_rate,
+	.determine_rate = sf19a2890_muxdiv_determine_rate,
+	.set_rate = sf19a2890_muxdiv_set_rate,
+	.enable = sf19a2890_muxdiv_enable,
+	.disable = sf19a2890_muxdiv_disable,
+	.is_enabled = sf19a2890_muxdiv_is_enabled,
+	.get_parent = sf19a2890_muxdiv_get_parent,
+	.set_parent = sf19a2890_muxdiv_set_parent,
+};
+
+static int sf19a2890_gate_enable(struct clk_hw *hw)
+{
+	struct sf19a2890_clk *clk = to_sf19a2890_clk(hw);
+	u32 val;
+
+	guard(spinlock_irqsave)(&clk->sysm->lock);
+
+	val = sf19a2890_readl(clk, REG_PERIPH_GATE);
+	sf19a2890_writel(clk, REG_PERIPH_GATE, val | BIT(clk->bit));
+	sf19a2890_writel(clk, REG_PERIPH_BOE, PERIPH_BOE_EN);
+
+	return 0;
+}
+
+static void sf19a2890_gate_disable(struct clk_hw *hw)
+{
+	struct sf19a2890_clk *clk = to_sf19a2890_clk(hw);
+	u32 val;
+
+	guard(spinlock_irqsave)(&clk->sysm->lock);
+
+	val = sf19a2890_readl(clk, REG_PERIPH_GATE) & ~BIT(clk->bit);
+	sf19a2890_writel(clk, REG_PERIPH_GATE, val);
+	/* The bus outputs stay enabled while any gate of the block is on */
+	if (!val)
+		sf19a2890_writel(clk, REG_PERIPH_BOE, 0);
+}
+
+static int sf19a2890_gate_is_enabled(struct clk_hw *hw)
+{
+	struct sf19a2890_clk *clk = to_sf19a2890_clk(hw);
+
+	return !!(sf19a2890_readl(clk, REG_PERIPH_GATE) & BIT(clk->bit));
+}
+
+static const struct clk_ops sf19a2890_gate_ops = {
+	.enable = sf19a2890_gate_enable,
+	.disable = sf19a2890_gate_disable,
+	.is_enabled = sf19a2890_gate_is_enabled,
+};
+
+static const struct clk_parent_data sf19a2890_pll_parents[] = {
+	{ .fw_name = "osc12m" },
+	{ .fw_name = "osc40m" },
+};
+
+static struct sf19a2890_clk sf19a2890_plls[] = {
+	[CLK_PLL_CPU] = {
+		.offset = PLL_CPU,
+		.hw.init = CLK_HW_INIT_PARENTS_DATA("pll_cpu",
+						   sf19a2890_pll_parents,
+						   &sf19a2890_pll_ops, 0),
+	},
+	[CLK_PLL_DDR] = {
+		.offset = PLL_DDR,
+		.hw.init = CLK_HW_INIT_PARENTS_DATA("pll_ddr",
+						   sf19a2890_pll_parents,
+						   &sf19a2890_pll_ops, 0),
+	},
+	[CLK_PLL_CMN] = {
+		.offset = PLL_CMN,
+		.hw.init = CLK_HW_INIT_PARENTS_DATA("pll_cmn",
+						   sf19a2890_pll_parents,
+						   &sf19a2890_pll_ops, 0),
+	},
+};
+
+static const struct clk_parent_data sf19a2890_muxdiv_parents[] = {
+	{ .hw = &sf19a2890_plls[CLK_PLL_CPU].hw },
+	{ .hw = &sf19a2890_plls[CLK_PLL_DDR].hw },
+	{ .hw = &sf19a2890_plls[CLK_PLL_CMN].hw },
+	{ .fw_name = "osc12m" },
+	{ .fw_name = "osc40m" },
+};
+
+#define SF19A2890_MUXDIV(_id, _name, _offset, _flags)			\
+	[(_id) - CLK_MUXDIV_BUS1] = {					\
+		.offset = MUXDIV(_offset),				\
+		.hw.init = CLK_HW_INIT_PARENTS_DATA(_name,		\
+					sf19a2890_muxdiv_parents,	\
+					&sf19a2890_muxdiv_ops, _flags),	\
+	}
+
+static struct sf19a2890_clk sf19a2890_muxdivs[] = {
+	SF19A2890_MUXDIV(CLK_MUXDIV_BUS1, "bus1", 0x000, CLK_IS_CRITICAL),
+	SF19A2890_MUXDIV(CLK_MUXDIV_BUS2, "bus2", 0x020, CLK_IS_CRITICAL),
+	SF19A2890_MUXDIV(CLK_MUXDIV_BUS3, "bus3", 0x040, CLK_IS_CRITICAL),
+	SF19A2890_MUXDIV(CLK_MUXDIV_CPU, "cpu", 0x100,
+			 CLK_SET_RATE_PARENT | CLK_SET_RATE_NO_REPARENT),
+	SF19A2890_MUXDIV(CLK_MUXDIV_PBUS, "pbus", 0x120, CLK_IS_CRITICAL),
+	SF19A2890_MUXDIV(CLK_MUXDIV_MEM_PHY, "mem_phy", 0x140,
+			 CLK_IS_CRITICAL),
+	SF19A2890_MUXDIV(CLK_MUXDIV_UART, "uart", 0x180, 0),
+	SF19A2890_MUXDIV(CLK_MUXDIV_ETH_REF, "eth_ref", 0x200, 0),
+	SF19A2890_MUXDIV(CLK_MUXDIV_ETH_BYP_REF, "eth_byp_ref", 0x220, 0),
+	SF19A2890_MUXDIV(CLK_MUXDIV_ETH_TSU, "eth_tsu", 0x240, 0),
+	SF19A2890_MUXDIV(CLK_MUXDIV_GMAC_BYP_REF, "gmac_byp_ref", 0x260, 0),
+	SF19A2890_MUXDIV(CLK_MUXDIV_M6250_0, "m6250_0", 0x280, 0),
+	SF19A2890_MUXDIV(CLK_MUXDIV_M6250_1, "m6250_1", 0x2a0, 0),
+	SF19A2890_MUXDIV(CLK_MUXDIV_WLAN24_PLF, "wlan24_plf", 0x2c0, 0),
+	SF19A2890_MUXDIV(CLK_MUXDIV_WLAN5_PLF, "wlan5_plf", 0x2e0, 0),
+	SF19A2890_MUXDIV(CLK_MUXDIV_USBPHY_REF, "usbphy_ref", 0x300, 0),
+	SF19A2890_MUXDIV(CLK_MUXDIV_TCLK, "tclk", 0x320, 0),
+	SF19A2890_MUXDIV(CLK_MUXDIV_NPU_PE, "npu_pe", 0x340, 0),
+};
+
+#define MUXDIV_HW(_id) (&sf19a2890_muxdivs[(_id) - CLK_MUXDIV_BUS1].hw)
+
+struct sf19a2890_gate {
+	unsigned int id;
+	const char *name;
+	struct clk_parent_data parent;
+	u32 periph;
+	u32 bit;
+	unsigned long flags;
+};
+
+#define SF19A2890_GATE(_id, _name, _parent, _periph, _bit, _flags)	\
+	{								\
+		.id = _id,						\
+		.name = _name,						\
+		.parent = { .hw = MUXDIV_HW(_parent) },			\
+		.periph = _periph,					\
+		.bit = _bit,						\
+		.flags = _flags,					\
+	}
+
+#define SF19A2890_GATE_FW(_id, _name, _fw_name, _periph, _bit)		\
+	{								\
+		.id = _id,						\
+		.name = _name,						\
+		.parent = { .fw_name = _fw_name },			\
+		.periph = _periph,					\
+		.bit = _bit,						\
+	}
+
+static const struct sf19a2890_gate sf19a2890_gates[] = {
+	SF19A2890_GATE(CLK_GMAC, "gmac", CLK_MUXDIV_BUS1, PERIPH_GMAC, 0, 0),
+	SF19A2890_GATE(CLK_GMAC_PCLK, "gmac_pclk", CLK_MUXDIV_CPU,
+		       PERIPH_GMAC, 1, 0),
+	SF19A2890_GATE(CLK_GMAC_BYP_REF, "gmac_byp_ref_gate",
+		       CLK_MUXDIV_GMAC_BYP_REF, PERIPH_GMAC, 2, 0),
+	SF19A2890_GATE(CLK_GMAC_ETH_TSU, "gmac_eth_tsu", CLK_MUXDIV_ETH_TSU,
+		       PERIPH_GMAC, 3, 0),
+	SF19A2890_GATE(CLK_WLAN24_AXIS, "wlan24_axis", CLK_MUXDIV_CPU,
+		       PERIPH_WLAN24, 0, 0),
+	SF19A2890_GATE(CLK_WLAN24_AXIM, "wlan24_axim", CLK_MUXDIV_BUS2,
+		       PERIPH_WLAN24, 1, 0),
+	SF19A2890_GATE(CLK_WLAN24_PLF, "wlan24_plf_gate",
+		       CLK_MUXDIV_WLAN24_PLF, PERIPH_WLAN24, 2, 0),
+	SF19A2890_GATE(CLK_RF_DFT, "rf_dft", CLK_MUXDIV_BUS2, PERIPH_RF, 0, 0),
+	SF19A2890_GATE(CLK_RF_AXIS, "rf_axis", CLK_MUXDIV_CPU, PERIPH_RF, 1, 0),
+	SF19A2890_GATE_FW(CLK_RF_BOOT, "rf_boot", "osc12m", PERIPH_RF, 2),
+	SF19A2890_GATE_FW(CLK_RF_LP, "rf_lp", "osc32k", PERIPH_RF, 3),
