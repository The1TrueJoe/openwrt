/dts-v1/;

#include <dt-bindings/input/input.h>
#include "sf19a2890.dtsi"

/ {
	model = "GL.iNet GL-SFT1200";
	compatible = "glinet,gl-sft1200", "siflower,sf19a2890";

	aliases {
		label-mac-device = &gmac;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@0 {
		device_type = "memory";
		reg = <0x0 0x8000000>;
	};

	keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&gpio 27 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};

		mode {
			label = "mode";
			gpios = <&gpio 1 GPIO_ACTIVE_LOW>;
			linux,code = <BTN_0>;
			linux,input-type = <EV_SW>;
		};
	};
};

&gmac {
	status = "okay";
	phy-mode = "rgmii";
	snps,ps-speed = <1000>;
	nvmem-cells = <&macaddr_factory_0 0>, <&rgmii_delay_factory_b2>;
	nvmem-cell-names = "mac-address", "rgmii-delay";

	/*
	 * The FIFO sizes are not documented and this DWMAC 3.73a does not
	 * report them. Without a TX FIFO size stmmac refuses any MTU change,
	 * so DSA cannot make room for the switch tag on the conduit. The
	 * vendor firmware sends 1522-byte VLAN-tagged frames in TX
	 * store-and-forward mode, so the TX FIFO holds at least 2 KiB. An RX
	 * FIFO size below 4 KiB keeps hardware flow control off, as the
	 * vendor driver leaves it.
	 */
	tx-fifo-depth = <2048>;
	rx-fifo-depth = <2048>;

	fixed-link {
		speed = <1000>;
		full-duplex;
		pause;
	};
};

&mdio {
	switch@0 {
		compatible = "intel,gsw150";
		reg = <0>;

		ports {
			#address-cells = <1>;
			#size-cells = <0>;

			port@0 {
				reg = <0>;
				label = "wan";
				phy-handle = <&switchphy0>;
				phy-mode = "internal";
				nvmem-cells = <&macaddr_factory_0 0>;
				nvmem-cell-names = "mac-address";
			};

			port@1 {
				reg = <1>;
				label = "lan2";
				phy-handle = <&switchphy1>;
				phy-mode = "internal";
				nvmem-cells = <&macaddr_factory_0 1>;
				nvmem-cell-names = "mac-address";
			};

			port@2 {
				reg = <2>;
				label = "lan1";
				phy-handle = <&switchphy2>;
				phy-mode = "internal";
				nvmem-cells = <&macaddr_factory_0 1>;
				nvmem-cell-names = "mac-address";
			};

			/* The GMAC adds both RGMII delays (rgmii-delay above). */
			port@5 {
				reg = <5>;
				phy-mode = "rgmii-id";
				tx-internal-delay-ps = <0>;
				rx-internal-delay-ps = <0>;
				ethernet = <&gmac>;

				fixed-link {
					speed = <1000>;
					full-duplex;
				};
			};
		};

		mdio {
			#address-cells = <1>;
			#size-cells = <0>;

			switchphy0: ethernet-phy@0 {
				reg = <0>;
			};

			switchphy1: ethernet-phy@1 {
				reg = <1>;
			};

			switchphy2: ethernet-phy@2 {
				reg = <2>;
			};
		};
	};
};

&spi {
	status = "okay";

	flash@0 {
		compatible = "spi-nand";
		reg = <0>;
		spi-max-frequency = <30000000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "spl-loader";
				reg = <0x0 0x20000>;
				read-only;
			};

			partition@20000 {
				label = "u-boot";
				reg = <0x20000 0x60000>;
				read-only;
			};

			partition@80000 {
				label = "u-boot-env";
				reg = <0x80000 0x20000>;
				read-only;
			};

			partition@a0000 {
				label = "factory";
				reg = <0xa0000 0x20000>;
				read-only;

				nvmem-layout {
					compatible = "fixed-layout";
					#address-cells = <1>;
					#size-cells = <1>;

					macaddr_factory_0: macaddr@0 {
						compatible = "mac-base";
						reg = <0x0 0x6>;
						#nvmem-cell-cells = <1>;
					};

					rgmii_delay_factory_b2: rgmii-delay@b2 {
						reg = <0xb2 0x4>;
					};
				};
			};

			/* U-Boot loads only the first 3 MiB of this partition */
			partition@c0000 {
				label = "kernel";
				reg = <0xc0000 0x400000>;
			};

			partition@4c0000 {
				label = "ubi";
				reg = <0x4c0000 0x7940000>;
			};

			partition@7e00000 {
				label = "log";
				reg = <0x7e00000 0x40000>;
			};
		};
	};
};

&uart0 {
	status = "okay";
};

&usb {
	status = "okay";
};

&usb_phy {
	status = "okay";
};
