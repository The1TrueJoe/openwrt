From: Joseph Telaak <joseph@telaak.dev>
Subject: [PATCH] gpio: regmap: take gpio-regmap from the gpio tree (bench only)

The SF19A2890 GPIO driver v3 uses the gpio_regmap_operation argument of
reg_mask_xlate(), set_config() and the IRQ helpers, all added in 2026.
This carries the gpio tree's gpio-regmap.c and regmap.h, with
pm_runtime_resume_and_get() for pm_runtime_get_active() and kzalloc()
for kzalloc_obj(), which 6.18 lacks. For the bench only.

---
diff -ruN a/drivers/gpio/gpio-regmap.c b/drivers/gpio/gpio-regmap.c
--- a/drivers/gpio/gpio-regmap.c	2026-11-17 14:43:59
+++ b/drivers/gpio/gpio-regmap.c	2026-11-17 15:49:06
@@ -6,10 +6,13 @@
  */
 
 #include <linux/bits.h>
+#include <linux/cleanup.h>
+#include <linux/compiler_attributes.h>
 #include <linux/device.h>
 #include <linux/err.h>
 #include <linux/io.h>
 #include <linux/module.h>
+#include <linux/pm_runtime.h>
 #include <linux/regmap.h>
 #include <linux/slab.h>
 #include <linux/types.h>
@@ -22,6 +25,8 @@
 struct gpio_regmap {
 	struct device *parent;
 	struct regmap *regmap;
+	struct device *pm_dev;
+
 	struct gpio_chip gpio_chip;
 
 	int reg_stride;
@@ -31,6 +36,7 @@
 	unsigned int reg_clr_base;
 	unsigned int reg_dir_in_base;
 	unsigned int reg_dir_out_base;
+	unsigned long *fixed_direction_mask;
 	unsigned long *fixed_direction_output;
 
 #ifdef CONFIG_REGMAP_IRQ
@@ -38,10 +44,20 @@
 	struct regmap_irq_chip_data *irq_chip_data;
 #endif
 
-	int (*reg_mask_xlate)(struct gpio_regmap *gpio, unsigned int base,
-			      unsigned int offset, unsigned int *reg,
-			      unsigned int *mask);
+	int (*reg_mask_xlate)(struct gpio_regmap *gpio,
+			      enum gpio_regmap_operation op,
+			      unsigned int base, unsigned int offset,
+			      unsigned int *reg, unsigned int *mask);
 
+	int (*value_xlate)(struct gpio_regmap *gpio,
+			   enum gpio_regmap_operation op,
+			   unsigned int base, unsigned int offset,
+			   unsigned int reg, unsigned int *mask,
+			   unsigned int *val);
+
+	int (*set_config)(struct gpio_regmap *gpio, struct gpio_chip *chip,
+			  unsigned int offset, unsigned long config);
+
 	void *driver_data;
 };
 
@@ -54,6 +70,7 @@
 }
 
