From: Joseph Telaak <jttelaak@hotmail.com>
Subject: [PATCH] leds: aw2013: add hardware breathing via hw_pattern

The AW2013 breathes on its own: once told a rise, high, fall and low
time it ramps a channel up and down with no further help from the host.
The driver only uses that mode for blink_set, with zero rise and fall
times, so a breathing light today has to be faked with a software
pattern, which on a small SoC is an I2C write per channel every 50 ms.

Implement pattern_set and pattern_clear so the pattern trigger's
hw_pattern drives the chip's breathing mode directly. A pattern is the
four stages the hardware has, written the way the software pattern
trigger would play the same breath, so one string works in either mode.
Durations round up to the chip's 130 ms * 2^n steps, and repeat maps
onto the chip's own repeat count.

Signed-off-by: Joseph Telaak <jttelaak@hotmail.com>
---
 Documentation/leds/index.rst       |  1 +
 Documentation/leds/leds-aw2013.rst | 28 +++++++++
 drivers/leds/leds-aw2013.c         | 95 ++++++++++++++++++++++++++++++
 3 files changed, 124 insertions(+)
 create mode 100644 Documentation/leds/leds-aw2013.rst

diff --git a/Documentation/leds/index.rst b/Documentation/leds/index.rst
index 76fae17..d0d3d68 100644
--- a/Documentation/leds/index.rst
+++ b/Documentation/leds/index.rst
@@ -16,6 +16,7 @@ LEDs
 
    uleds
 
+   leds-aw2013
    leds-blinkm
    leds-cht-wcove
    leds-el15203000
diff --git a/Documentation/leds/leds-aw2013.rst b/Documentation/leds/leds-aw2013.rst
new file mode 100644
index 0000000..3c43c1b
--- /dev/null
+++ b/Documentation/leds/leds-aw2013.rst
@@ -0,0 +1,28 @@
+.. SPDX-License-Identifier: GPL-2.0
+
+===============================
+Kernel driver for Awinic AW2013
+===============================
+
+/sys/class/leds/<led>/hw_pattern
+--------------------------------
+
+Specify a hardware breathing pattern for one AW2013 channel. The chip
+ramps the channel from off up to one brightness, holds it, ramps back
+down and keeps it off, then starts over, so a pattern is always four
+stages::
+
+    "0 rise_duration brightness high_duration brightness fall_duration 0 low_duration"
+
+This is the same breath the software pattern trigger plays from the same
+string, so a pattern can be tried in software and moved to hardware
+unchanged.
+
+Each duration is rounded up to the next one the chip can do, which is
+130 ms times a power of two:
+
+- rise and fall: 130 ms to 16640 ms
+- high: 130 ms to 4160 ms
+- low: 130 ms to 16640 ms
+
+/sys/class/leds/<led>/repeat may be -1 (forever) or 1 to 15.
diff --git a/drivers/leds/leds-aw2013.c b/drivers/leds/leds-aw2013.c
index 216755d..252f7ea 100644
--- a/drivers/leds/leds-aw2013.c
+++ b/drivers/leds/leds-aw2013.c
@@ -261,6 +261,99 @@ out:
 	return ret;
 }
 
+/* Round a duration up to the next time the HW can do, at most step @max. */
+static u8 aw2013_time_code(u32 *delta_t, u8 max)
+{
+	u8 code = 0;
+
+	if (*delta_t > AW2013_TIME_STEP)
+		code = min_t(u32, max,
+			     ilog2((*delta_t - 1) / AW2013_TIME_STEP) + 1);
+
+	*delta_t = BIT(code) * AW2013_TIME_STEP;
+
+	return code;
+}
+
+/*
+ * The hardware breathes: it ramps from off up to one brightness, holds it,
+ * ramps back down and stays off, then starts over. So a pattern is exactly
+ * four tuples, "0 rise high hold high fall 0 off", which the software pattern
+ * trigger also plays as a breath.
+ */
+static int aw2013_pattern_set(struct led_classdev *cdev,
+			      struct led_pattern *pattern, u32 len,
+			      int repeat)
+{
+	struct aw2013_led *led = container_of(cdev, struct aw2013_led, cdev);
+	int ret, num = led->num;
+	u8 rise, high, fall, low;
+
+	if (len != 4 || pattern[0].brightness || pattern[3].brightness ||
+	    !pattern[1].brightness ||
+	    pattern[1].brightness != pattern[2].brightness)
+		return -EINVAL;
+
+	/* -1 is forever, which the HW spells as a repeat count of 0. */
+	if (repeat == 0 || repeat > 15)
+		return -EINVAL;
+	if (repeat < 0)
+		repeat = 0;
+
+	rise = aw2013_time_code(&pattern[0].delta_t, 7);
+	high = aw2013_time_code(&pattern[1].delta_t, 5);
+	fall = aw2013_time_code(&pattern[2].delta_t, 7);
+	low = aw2013_time_code(&pattern[3].delta_t, 7);
+
+	mutex_lock(&led->chip->mutex);
+
+	led->cdev.brightness = pattern[1].brightness;
+	ret = aw2013_chip_enable(led->chip);
+	if (ret)
+		goto out;
+
+	/* Off while it is set up, so the first breath starts from the bottom. */
+	ret = regmap_update_bits(led->chip->regmap, AW2013_LCTR,
+				 AW2013_LCTR_LE(num), 0);
+	if (ret)
+		goto out;
+	ret = regmap_write(led->chip->regmap, AW2013_REG_PWM(num),
+			   pattern[1].brightness);
+	if (ret)
+		goto out;
+	ret = regmap_write(led->chip->regmap, AW2013_LEDT0(num),
+			   AW2013_LEDT0_T1(rise) | AW2013_LEDT0_T2(high));
+	if (ret)
+		goto out;
+	ret = regmap_write(led->chip->regmap, AW2013_LEDT1(num),
+			   AW2013_LEDT1_T3(fall) | AW2013_LEDT1_T4(low));
+	if (ret)
+		goto out;
+	ret = regmap_write(led->chip->regmap, AW2013_LEDT2(num),
+			   AW2013_LEDT2_T0(0) | AW2013_LEDT2_REPEAT(repeat));
+	if (ret)
+		goto out;
+	ret = regmap_update_bits(led->chip->regmap, AW2013_LCFG(num),
+				 AW2013_LCFG_MD, 0xFF);
+	if (ret)
+		goto out;
+
+	ret = regmap_update_bits(led->chip->regmap, AW2013_LCTR,
+				 AW2013_LCTR_LE(num), 0xFF);
+
+out:
+	mutex_unlock(&led->chip->mutex);
+
+	return ret;
+}
+
+static int aw2013_pattern_clear(struct led_classdev *cdev)
+{
+	cdev->brightness = LED_OFF;
+
+	return aw2013_brightness_set(cdev, LED_OFF);
+}
+
 static int aw2013_probe_dt(struct aw2013 *chip)
 {
 	struct device_node *np = dev_of_node(&chip->client->dev);
@@ -301,6 +394,8 @@ static int aw2013_probe_dt(struct aw2013 *chip)
 
 		led->cdev.brightness_set_blocking = aw2013_brightness_set;
 		led->cdev.blink_set = aw2013_blink_set;
+		led->cdev.pattern_set = aw2013_pattern_set;
+		led->cdev.pattern_clear = aw2013_pattern_clear;
 
 		ret = devm_led_classdev_register_ext(&chip->client->dev,
 						     &led->cdev, &init_data);
