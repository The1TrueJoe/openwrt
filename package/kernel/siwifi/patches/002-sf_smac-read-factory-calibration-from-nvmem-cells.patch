diff --git a/sf_smac/src/rf/sf_factory.c b/sf_smac/src/rf/sf_factory.c
new file mode 100644
index 0000000..e9ad0dc
--- /dev/null
+++ b/sf_smac/src/rf/sf_factory.c
@@ -0,0 +1,102 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Per-board Wi-Fi factory data for the SF19A2890 radios.
+ *
+ * The vendor kernel had a separate sfax8_factory_read module that read the
+ * "factory" MTD partition at offsets hard-wired in its own DT node. Here the
+ * same data comes from nvmem cells on the RF node instead:
+ *
+ *   "calibration"   the block at factory offset 0x800: a two-byte version
+ *                   tag ("XO", "V2", "V3" or "V4"), the two-byte XO trim and
+ *                   the per-band tx-power tables. 0x800 bytes cover the
+ *                   single-antenna formats, "V4" needs 0xd36.
+ *   "cooling-temp"  optional, two bytes (factory offset 0xae on most boards)
+ *
+ * The cells are looked up when they are needed, so the MAC driver does not
+ * depend on the RF device having probed first.
+ */
+#include <linux/minmax.h>
+#include <linux/module.h>
+#include <linux/nvmem-consumer.h>
+#include <linux/of.h>
+#include <linux/slab.h>
+#include "sfax8_factory_read.h"
+
+#define SF_RF_COMPATIBLE	"siflower,sf19a2890-rf"
+
+static int sf_factory_read_cell(const char *name, size_t off, void *buf,
+				size_t len)
+{
+	struct device_node *np;
+	struct nvmem_cell *cell;
+	size_t cell_len;
+	void *data;
+	int ret = 0;
+
+	np = of_find_compatible_node(NULL, NULL, SF_RF_COMPATIBLE);
+	if (!np)
+		return -ENODEV;
+
+	cell = of_nvmem_cell_get(np, name);
+	of_node_put(np);
+	if (IS_ERR(cell))
+		return PTR_ERR(cell);
+
+	data = nvmem_cell_read(cell, &cell_len);
+	nvmem_cell_put(cell);
+	if (IS_ERR(data))
+		return PTR_ERR(data);
+
+	if (off + len > cell_len)
+		ret = -EINVAL;
+	else
+		memcpy(buf, data + off, len);
+
+	kfree(data);
+	return ret;
+}
+
+/* An erased block reads 0xff; only a known tag means a table follows. */
+static bool sf_factory_cali_valid(void)
+{
+	char v[WIFI_VERSION_SIZE];
+
+	if (sf_factory_read_cell("calibration", 0, v, sizeof(v)))
+		return false;
+
+	return (v[0] == 'X' && v[1] == 'O') ||
+	       (v[0] == 'V' && v[1] >= '2' && v[1] <= '4');
+}
+
+int sf_get_value_from_factory(enum sfax8_factory_read_action action,
+			      void *buffer, int len)
+{
+	if (!buffer || len <= 0)
+		return -EINVAL;
+
+	switch (action) {
+	case READ_WIFI_VERSION:
+		return sf_factory_read_cell("calibration", 0, buffer,
+					    min(len, WIFI_VERSION_SIZE));
+	case READ_RF_XO_CONFIG:
+		if (!sf_factory_cali_valid())
+			return -ENOENT;
+		return sf_factory_read_cell("calibration", WIFI_VERSION_SIZE,
+					    buffer, min(len, XO_CONFIG_SIZE));
+	case READ_WIFI_INFO:
+		if (!sf_factory_cali_valid())
+			return -ENOENT;
+		return sf_factory_read_cell("calibration", WIFI_VERSION_SIZE,
+					    buffer, len);
+	case READ_COOLING_TEMP:
+		return sf_factory_read_cell("cooling-temp", 0, buffer,
+					    min(len, COOLING_TEMP_SIZE));
+	default:
+		/*
+		 * The MACs take their address from the "mac-address" cell on
+		 * their own nodes; returning an error here selects that path.
+		 */
+		return -ENOENT;
+	}
+}
+EXPORT_SYMBOL_GPL(sf_get_value_from_factory);
diff --git a/sf_smac/src/rf/sfax8_factory_read.h b/sf_smac/src/rf/sfax8_factory_read.h
new file mode 100644
index 0000000..5b13d4b
--- /dev/null
+++ b/sf_smac/src/rf/sfax8_factory_read.h
@@ -0,0 +1,31 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * Factory data accessor shared by the RF and MAC drivers. The name and the
+ * interface follow the vendor's sfax8_factory_read module, so the drivers'
+ * call sites stay as they are; the implementation is in sf_factory.c.
+ */
+#ifndef _SFAX8_FACTORY_READ_H_
+#define _SFAX8_FACTORY_READ_H_
+
+/* sizes in bytes */
+#define WIFI_VERSION_SIZE	2
+#define XO_CONFIG_SIZE		2
+#define COOLING_TEMP_SIZE	2
+/* the rest of the 0x800-byte block; 2 (XO) + 364 + 1325 + 83 = 1774 are used */
+#define WIFI_INFO_SIZE		2046
+/* "V4": 2 (XO) + (364 + 1325) * 2 antennas */
+#define WIFI_INFO_SIZE_V4	3380
+
+enum sfax8_factory_read_action {
+	READ_WIFI_LB_MAC_ADDRESS,
+	READ_WIFI_HB_MAC_ADDRESS,
+	READ_WIFI_VERSION,
+	READ_RF_XO_CONFIG,
+	READ_WIFI_INFO,
+	READ_COOLING_TEMP,
+};
+
+int sf_get_value_from_factory(enum sfax8_factory_read_action action,
+			      void *buffer, int len);
+
+#endif /* _SFAX8_FACTORY_READ_H_ */
